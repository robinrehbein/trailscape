// Gelaende der Indoor-Darstellung: ersetzt das gltfio-Material `mat_terrain` der Kacheln
// (WorldMaterialProvider in der App, derselbe Tausch in filarender). Grundfarbe bleibt das
// Luftbild der Kachel (`baseColorMap`, von gltfio gebunden). Nahe am Fahrer kommt kachelbares
// Detail dazu (GroundDetail, 4 Bodenarten in RGBA): die Bodenart je Pixel aus der Farbe des
// Luftbilds und der Hangneigung, das Detail moduliert nur die Helligkeit (Mittel bleibt) und
// liefert eine Detail-Normale aus Differenzen. Ab `detailRange` Metern weich aus — dort ist
// das Material so teuer wie das gltfio-Material (ein Texturzugriff).
//
// Detail-UV aus der Kachel-UV (0..1 ueber 256 m, mit halbem Texel Einzug), nicht aus
// Weltkoordinaten: klein und genau, nahtlos ueber Kachelgrenzen (ganzzahlige Wiederholungen).
//
// Die Parameter baseColorFactor … aoStrength setzt gltfio (AssetLoader.cpp) auf jede
// Materialinstanz — sie muessen existieren, auch wenn sie kaum etwas tun.
//
// PBR-Texturen (PbrTextures, docs/indoor/pbr-texturen.md): mit `pbrA.x` > 0 ersetzt nah ein
// Textur-Array mit vier Bodenarten (Wiese, Acker, Waldboden, Fels; Farbdetail + Rauheit,
// Normale) das Boden-Detail: die zwei staerksten Bodenarten des Pixels, Farbe weiter aus dem
// Luftbild (nur Detail mit Mittel 1), Normale und Rauheit aus der Textur, die staerkste in zwei
// Massstaeben. Wiederholungen je Kachel ganzzahlig (nahtlos). `pbrA.x` = 0: wie vorher.
//
// Kompilieren: tool/indoor-dev/filament/materials.sh (matc 1.75.1).
material {
    name : TrailscapeTerrain,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : baseColorMap },
        { type : float4, name : baseColorFactor },
        { type : float3, name : emissiveFactor },
        { type : float, name : metallicFactor },
        { type : float, name : roughnessFactor },
        { type : float, name : normalScale },
        { type : float, name : aoStrength },
        { type : sampler2d, name : detailMap, precision : medium },
        { type : sampler2d, name : macroMap, precision : medium },
        { type : float, name : detailRange },
        { type : float, name : detailRepeat },
        { type : float, name : macroRepeat },
        { type : float, name : detailStrength },
        { type : float, name : bumpStrength },
        { type : float, name : macroStrength },
        { type : float, name : forestWarmth },
        { type : float, name : warmRange },
        { type : sampler2dArray, name : pbrMapC, precision : medium },
        { type : sampler2dArray, name : pbrMapN, precision : medium },
        { type : float4, name : pbrA },
        { type : float4, name : pbrB },
        { type : float4, name : pbrC }
    ],
    shadingModel : lit,
    blending : opaque,
    flipUV : false,
    featureLevel : 1
}

fragment {
    // Drehung um k × 90° (haelt die Wiederholung je Kachel nahtlos), je Bodenart anders.
    highp vec2 rot90(highp vec2 p, float k) {
        if (k < 0.5) return p;
        if (k < 1.5) return vec2(-p.y, p.x);
        if (k < 2.5) return -p;
        return vec2(p.y, -p.x);
    }

    // Eine Bodenart: Farbdetail (Mittel 1) in rgb, Rauheit in a; Normale X/Y in Weltrichtung (x, z).
    vec4 pbrLayer(highp vec2 local, highp vec2 lx, highp vec2 ly, float layer, float rep, out vec2 n) {
        highp vec2 q = rot90(local * rep, layer);
        vec2 gx = rot90(lx * rep, layer);
        vec2 gy = rot90(ly * rep, layer);
        vec4 c = textureGrad(materialParams_pbrMapC, vec3(q, layer), gx, gy);
        vec2 t = textureGrad(materialParams_pbrMapN, vec3(q, layer), gx, gy).rg * 2.0 - 1.0;
        n = rot90(t, 4.0 - layer);  // zurueckdrehen (4 − k ≡ −k)
        return vec4(c.rgb * 2.0, c.a);
    }

    void material(inout MaterialInputs material) {
        highp vec2 uv = getUV0();
        // Kachelkoordinate 0..1 genau aus der UV (halber Texel Einzug wie im Weltbau), Ableitungen vor jeder Verzweigung
        highp vec2 ts0 = vec2(textureSize(materialParams_baseColorMap, 0));
        highp vec2 inset0 = 0.5 / ts0;
        highp vec2 local0 = (uv - inset0) / (1.0 - 2.0 * inset0);
        highp vec2 lx = dFdx(local0);
        highp vec2 ly = dFdy(local0);
        vec3 aerial = texture(materialParams_baseColorMap, uv).rgb * materialParams.baseColorFactor.rgb;
        vec3 base = aerial;

        highp vec3 toCam = getWorldPosition() - getWorldCameraPosition();
        float dist = length(toCam);

        // Bodenart aus der Luftbildfarbe (linear): Wiese gruen, Acker/Erde braun-beige,
        // Waldboden dunkel, Schotter/Fels grau oder steil.
        float mx = max(aerial.r, max(aerial.g, aerial.b));
        float mn = min(aerial.r, min(aerial.g, aerial.b));
        float inv = 1.0 / max(mx, 0.004);
        float lum = dot(aerial, vec3(0.2126, 0.7152, 0.0722));
        float sat = (mx - mn) * inv;
        float green = (aerial.g - max(aerial.r, aerial.b)) * inv;
        float brown = (aerial.r - aerial.b) * inv;
        vec3 nGeo = normalize(getWorldTangentFrame()[2]);
        float steep = smoothstep(0.80, 0.62, abs(nGeo.y));

        float wGrass = smoothstep(-0.03, 0.10, green) * smoothstep(0.012, 0.03, lum);
        float wLitter = smoothstep(0.075, 0.035, lum) * (1.0 - 0.7 * wGrass) * smoothstep(0.75, 0.45, sat);
        float wStone = max(smoothstep(0.22, 0.06, sat) * smoothstep(0.04, 0.10, lum), steep);
        float wSoil = smoothstep(0.02, 0.22, brown) * (1.0 - wGrass);
        vec4 wts = vec4(wGrass, wSoil, wLitter, wStone) + vec4(0.02);
        wts /= (wts.x + wts.y + wts.z + wts.w);

        // Waldboden waermer ziehen (Laubstreu statt Blaugruen), in einem weiteren Umkreis als
        // das Detail, damit am Rand des Details keine Farbkante entsteht; die Ferne (Kronendach
        // von oben in den groben Stufen) bleibt unveraendert.
        float warm = materialParams.forestWarmth * wts.z * (1.0 - smoothstep(materialParams.warmRange * 0.6, materialParams.warmRange, dist));
        base = mix(base, vec3(lum) * vec3(1.42, 1.0, 0.62) * 1.08, warm);
        // Dunkles Blaugruen (Winter-Luftbild, Schatten im Luftbild) nah am Fahrer zu Gruenbraun
        float cool = smoothstep(0.0, 0.22, (aerial.b - aerial.r) * inv) * (1.0 - smoothstep(0.06, 0.16, lum));
        base = mix(base, vec3(lum) * vec3(1.12, 1.06, 0.66) * 1.05,
                   0.65 * cool * (1.0 - smoothstep(materialParams.warmRange * 0.6, materialParams.warmRange, dist)));

        vec3 nTs = vec3(0.0, 0.0, 1.0);
        float rough = materialParams.roughnessFactor;
        float range = materialParams.detailRange;
        float fade = range > 0.0 ? 1.0 - smoothstep(range * 0.55, range, dist) : 0.0;
        vec4 pA = materialParams.pbrA;  // Reichweite m, Normale, Farbdetail, Rauheit-Anteil
        float pw = pA.x > 0.0 ? 1.0 - smoothstep(pA.x * 0.55, pA.x, dist) : 0.0;
        if (pA.x > 0.0) fade = 0.0;  // PBR an: kein Boden-Detail
        if (pw > 0.001) {
            vec4 rp = materialParams.pbrB;  // Wiederholungen je Kachel der vier Bodenarten
            vec4 pC = materialParams.pbrC;  // Rauheit: Skala, Versatz
            // die zwei staerksten Bodenarten
            float i1 = 0.0;
            float w1 = wts.x;
            if (wts.y > w1) { i1 = 1.0; w1 = wts.y; }
            if (wts.z > w1) { i1 = 2.0; w1 = wts.z; }
            if (wts.w > w1) { i1 = 3.0; w1 = wts.w; }
            vec4 rest = wts;
            rest[int(i1)] = -1.0;
            float i2 = 0.0;
            float w2 = rest.x;
            if (rest.y > w2) { i2 = 1.0; w2 = rest.y; }
            if (rest.z > w2) { i2 = 2.0; w2 = rest.z; }
            if (rest.w > w2) { i2 = 3.0; w2 = rest.w; }
            vec2 n1;
            vec4 t1 = pbrLayer(local0, lx, ly, i1, rp[int(i1)], n1);
            // zweiter, groeberer Massstab der staerksten Art gegen sichtbare Wiederholung
            vec2 n1b;
            vec4 t1b = pbrLayer(local0.yx, ly.yx, lx.yx, i1, floor(rp[int(i1)] / 3.0), n1b);
            t1.rgb *= mix(vec3(1.0), t1b.rgb, 0.45);
            t1.a = mix(t1.a, t1b.a, 0.3);
            n1 += 0.45 * n1b.yx;
            vec4 tc = t1;
            vec2 nc = n1;
            float b2 = smoothstep(0.08, 0.3, w2) * w2 / max(w1 + w2, 1e-3);
            if (b2 > 0.001) {
                vec2 n2;
                vec4 t2 = pbrLayer(local0, lx, ly, i2, rp[int(i2)], n2);
                tc = mix(tc, t2, b2);
                nc = mix(nc, n2, b2);
            }
            float m = texture(materialParams_macroMap, local0 * materialParams.macroRepeat).r;
            float k = (1.0 + materialParams.macroStrength * pw * (m - 0.5) * 2.0);
            base *= mix(vec3(1.0), tc.rgb, pA.z * pw) * max(k, 0.0);
            rough = mix(rough, tc.a * pC.x + pC.y, pA.w * pw);
            vec3 p = (nc.x * vec3(1.0, 0.0, 0.0) + nc.y * vec3(0.0, 0.0, 1.0)) * (pA.y * pw);
            p -= dot(p, nGeo) * nGeo;
            vec3 nW = normalize(nGeo + p);
            base *= 1.0 / max(dot(nW, nGeo), 0.55);  // Energieausgleich (wie auf der Fahrbahn)
            nTs = vec3(dot(nW, getWorldTangentFrame()[0]), dot(nW, getWorldTangentFrame()[1]), dot(nW, getWorldTangentFrame()[2]));
        } else if (fade > 0.001) {
            // Kachelkoordinate 0..1 genau aus der UV (halber Texel Einzug wie im Weltbau)
            highp vec2 ts = vec2(textureSize(materialParams_baseColorMap, 0));
            highp vec2 inset = 0.5 / ts;
            highp vec2 local = (uv - inset) / (1.0 - 2.0 * inset);
            highp vec2 duv = local * materialParams.detailRepeat;
            const float texel = 1.0 / 256.0;
            vec4 h0 = texture(materialParams_detailMap, duv);
            vec4 hx = texture(materialParams_detailMap, duv + vec2(texel, 0.0));
            vec4 hy = texture(materialParams_detailMap, duv + vec2(0.0, texel));
            float h = dot(h0, wts);
            float gx = dot(hx - h0, wts);
            float gy = dot(hy - h0, wts);
            float m = texture(materialParams_macroMap, local * materialParams.macroRepeat).r;

            // Helligkeit: Mittel 0,5 → Faktor 1 (Farbe des Luftbilds bleibt im Mittel)
            float k = 1.0 + materialParams.detailStrength * fade * (h - 0.5) * 2.0;
            k *= 1.0 + materialParams.macroStrength * fade * (m - 0.5) * 2.0;
            base *= max(k, 0.0);

            // Detail-Normale in Weltrichtung (u nach Osten = +x, v nach Sueden = +z),
            // dann in den Tangentenraum der Flaeche (dessen Drehung beliebig ist).
            float b = materialParams.bumpStrength * fade;
            vec3 p = -(gx * vec3(1.0, 0.0, 0.0) + gy * vec3(0.0, 0.0, 1.0)) * b;
            p -= dot(p, nGeo) * nGeo;
            vec3 nW = normalize(nGeo + p);
            nTs = vec3(dot(nW, getWorldTangentFrame()[0]), dot(nW, getWorldTangentFrame()[1]), dot(nW, getWorldTangentFrame()[2]));
        }
        material.normal = nTs;
        prepareMaterial(material);
        material.baseColor = vec4(base, 1.0);
        material.metallic = 0.0;
        material.roughness = rough;
        material.emissive = vec4(materialParams.emissiveFactor * 0.0, 0.0);
    }
}
