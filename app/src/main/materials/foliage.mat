// Laub, Nadeln und Grasbueschel der Indoor-Darstellung mit Wind: ersetzt die gltfio-Materialien
// `x_mat_tree_cards` (Blattkarten, Grasbueschel, Kreuzbilder; Atlas aus FoliageAtlas) und
// `mat_tree_leaves` (Kronendach der Waldkoerper) — WorldMaterialProvider in der App, derselbe
// Tausch in filarender. Aussehen wie das Ubershader-Material (Grundfarbe × Atlas × Vertexfarbe,
// Alpha-Maske, ohne Spiegelanteil); dazu ein billiges Wiegen im Vertex-Shader:
//
//  * Wiegen: zwei Sinus mit Phase aus der Weltlage (eine Boe laeuft durch den Wald),
//  * Flattern: schneller, kleiner, je Ecke verschieden,
//  * Gewicht aus der Lage im Atlas (`atlasMode` 1): Grasbueschel und Kreuzbilder ganzer Baeume
//    stehen unten fest und wiegen oben; Zweigkarten flattern ab ihrem Ansatz. Das Kronendach
//    (`atlasMode` 0) wiegt gleichmaessig und wenig.
//
// Ab `windRange` Metern steht alles still (kein Vertex-Aufwand sichtbar, keine Fern-Atlanten).
// Schatten wiegen mit (derselbe Vertex-Shader im Schattendurchgang).
//
// Kompilieren: tool/indoor-dev/filament/materials.sh (matc 1.75.1).
material {
    name : TrailscapeFoliage,
    requires : [ uv0, color ],
    parameters : [
        { type : sampler2d, name : baseColorMap },
        { type : float4, name : baseColorFactor },
        { type : float3, name : emissiveFactor },
        { type : float, name : metallicFactor },
        { type : float, name : roughnessFactor },
        { type : float, name : normalScale },
        { type : float, name : aoStrength },
        { type : float3, name : specularColorFactor },
        { type : float, name : specularStrength },
        { type : float, name : time },
        { type : float2, name : windDir },
        { type : float, name : windStrength },
        { type : float, name : windRange },
        { type : float, name : atlasMode }
    ],
    shadingModel : lit,
    blending : masked,
    doubleSided : true,
    flipUV : false,
    featureLevel : 1
}

vertex {
    // Gewicht des Wiegens (x) und des Flatterns (y) aus der Lage im Atlas (FoliageAtlas, 512²).
    vec2 windWeight(vec2 uv) {
        if (materialParams.atlasMode < 0.5) return vec2(0.35, 0.5);
        if (uv.x < 0.5) {
            if (uv.y < 0.5) {                      // Laubzweig: Ansatz unten
                float t = clamp((0.5 - uv.y) / 0.5, 0.0, 1.0);
                return vec2(0.5, 0.4 + 0.6 * t);
            }
            float t = clamp((1.0 - uv.y) / 0.5, 0.0, 1.0); // Kreuzbild: Stamm unten fest
            return vec2(t * t, 0.3 * t);
        }
        if (uv.y < 0.5) return vec2(0.5, 0.6);   // Nadelzweig, Fichtenquirl
        if (uv.y < 0.75) {                         // Grasbueschel: Halme von der Unterkante
            float t = clamp((0.75 - uv.y) / 0.25, 0.0, 1.0);
            return vec2(1.6 * t * t, 0.8 * t);
        }
        if (uv.x < 0.75) return vec2(0.4, 0.5);  // Laubmasse
        float t = clamp((1.0 - uv.y) / 0.25, 0.0, 1.0); // Farn
        return vec2(1.2 * t * t, 0.8 * t);
    }

    void materialVertex(inout MaterialVertexInputs material) {
        float strength = materialParams.windStrength;
        if (strength <= 0.0) return;
        highp vec3 wp = material.worldPosition.xyz;
        float dist = length(wp - getWorldCameraPosition());
        float range = materialParams.windRange;
        float fade = 1.0 - smoothstep(range * 0.6, range, dist);
        if (fade <= 0.0) return;
        vec2 w = windWeight(material.uv0);
        // Filaments Uhr (seit Start der Engine) plus Versatz: kein Setzen je Bild noetig.
        float t = getUserTime().x + materialParams.time;
        vec2 dir = materialParams.windDir;
        float ph = dot(wp.xz, dir) * 0.18 + dot(wp.xz, vec2(-dir.y, dir.x)) * 0.05;
        float gust = 0.55 + 0.45 * sin(t * 0.31 - ph * 0.25);
        float sway = (sin(t * 1.25 - ph) * 0.7 + sin(t * 2.05 - ph * 1.6) * 0.3) * gust;
        float flutter = sin(t * 5.3 + dot(wp, vec3(2.9, 2.1, 3.7)));
        vec3 d = vec3(dir.x, 0.0, dir.y) * (0.045 * w.x * (sway + 0.35 * gust))
               + vec3(0.6, 0.35, 0.6) * (0.018 * w.y * flutter);
        material.worldPosition.xyz += d * (strength * fade);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = texture(materialParams_baseColorMap, getUV0()) * materialParams.baseColorFactor * getColor();
        material.baseColor = c;
        material.metallic = 0.0;
        material.roughness = materialParams.roughnessFactor;
        material.reflectance = 0.0;
    }
}
