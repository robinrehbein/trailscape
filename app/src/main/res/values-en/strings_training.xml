    <!-- TrainingInsights.kt: Lastskala-Hinweis, je Herkunft der FTP ein ganzer Satz. -->
    <string name="training_insights_load_scale_entered">All load values use a threshold of %1$d W (%2$s W/kg), entered by you. If you change it in your profile, the scale shifts — retroactively for all past rides, too.</string>
    <string name="training_insights_load_scale_estimated">All load values use a threshold of %1$d W (%2$s W/kg), estimated from your weight alone. That’s a rough assumption (2.4 W/kg). Enter your FTP in your profile or record a ride with heart rate and elevation — either makes the scale more reliable and then shifts all past values.</string>
    <string name="training_insights_load_scale_twenty_min">All load values use a threshold of %1$d W (%2$s W/kg), estimated from your rides. It’s based on your best 20-minute stretch from the GPS power estimate (±15–25 %%). An entered FTP would be more accurate.</string>
    <string name="training_insights_load_scale_calibrated">All load values use a threshold of %1$d W (%2$s W/kg), adjusted from your heart rate. It’s based on a comparison with your measured heart rate. The value can shift with new rides — and past load values with it.</string>

