    <!-- ProblemReportDialog.kt -->
    <string name="more_report_title">Report a problem</string>
    <string name="more_report_intro">Trailscape has no error telemetry — without your report, nobody learns about a problem. The app version, device, Android version and – while the box below is ticked – the technical diagnostics are attached. You see the full text before you send it; nothing leaves your device without your tap.</string>
