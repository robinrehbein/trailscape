<?xml version="1.0" encoding="utf-8"?>
<!--
    Regeln fuer Androids Auto Backup (API 23-30, `android:fullBackupContent`).
    Ab API 31 gilt stattdessen res/xml/data_extraction_rules.xml — beide Dateien
    muessen inhaltlich zusammenpassen.

    Ohne <include> sichert Android per Voreinstellung alles: SharedPreferences
    und <filesDir> — also die Touren unter `rides/` und das Trainingsprofil.
    Fuer die Touren ist genau das gewollt. `getCacheDir()`, `getCodeCacheDir()`
    und `getNoBackupFilesDir()` nimmt Android ohnehin nie mit, sie brauchen
    hier keinen Eintrag. Ausgenommen wird, was auf einem anderen Geraet falsch
    oder zu gross waere — und was das Geraet nicht ungefragt verlassen darf:

    * `recording/` — das Journal einer LAUFENDEN Aufzeichnung inklusive
      Lock-Datei. Wird es auf einem zweiten Geraet eingespielt, meldet die App
      dort eine abgebrochene Tour und stellt fremde GPS-Punkte wieder her.
      Fertige Touren liegen zu diesem Zeitpunkt laengst unter `rides/`.
    * `mbgl-offline.db*` — die MapLibre-Kachel-Datenbank (Offline-Regionen und
      Ambient-Cache). Reiner Downloadinhalt, jederzeit neu beschaffbar, aber
      leicht mehrere hundert MB gross; Auto Backup deckelt eine App bei 25 MB
      und liesse das Backup sonst komplett scheitern. Die WAL-/SHM-Dateien
      stehen einzeln da, weil `path` nur ganze Pfadnamen trifft.
    * `segments/` — die Routing-Kacheln der Offline-Routenberechnung
      (`.rd5`). Dieselbe Begruendung wie bei der Kachel-Datenbank, nur
      deutlicher: EINE Kachel ist 119-240 MB gross. Ohne diese Ausnahme
      reisst schon die erste geladene Kachel die 25-MB-Grenze und laesst das
      Backup KOMPLETT scheitern — samt `rides/` und Trainingsprofil, also
      genau der Daten, die es retten soll. Reiner Downloadinhalt, jederzeit
      neu beschaffbar.
    * `brouter/` — Profil und Nachschlagetabelle der Routing-Engine. Klein,
      aber ueberfluessig: Beide werden beim Start aus den App-Assets neu
      ausgepackt.
    * `crash/` — der lokale Absturzbericht. Er ist eine Momentaufnahme GENAU
      DIESES Geraets (Stacktrace, Speicherstand, Modell) und auf einem anderen
      wertlos; vor allem aber verspricht die Datenschutzerklaerung
      (`PRIVACY.md`), dass Absturzberichte das Geraet nur verlassen, wenn der
      Nutzer sie selbst verschickt — ueber Auto Backup taeten sie es sonst
      stillschweigend.
    * `trailscape_prefs.xml` (SharedPreferences) — darin liegen das
      Sync-Zugangstoken im Klartext (`trailscape.sync`, siehe
      `core/SyncClient.kt`) und die lokale Vitalhistorie mit 400 Tagen
      Ruhepuls/HRV/Schlaf/VO2max (`trailscape.vitals.v1`, siehe
      `core/VitalsHistory.kt`). Beides gehoert nicht ungefragt in ein
      Google-Cloud-Backup — `PRIVACY.md` verspricht, dass Zugangsdaten und
      Gesundheitswerte das Geraet nur auf ausdruecklichen Wunsch verlassen.
      Konsequenz, und zwar gewollt: Einstellungen und Trainingsprofil wandern
      beim Geraetewechsel NICHT mehr automatisch mit; der dokumentierte Weg
      dafuer ist der manuelle Backup-Export (Mehr → Daten & Backup). Die
      Touren unter `rides/` bleiben im Auto Backup enthalten.
-->
<full-backup-content>
    <exclude domain="file" path="recording" />
    <exclude domain="file" path="crash" />
    <exclude domain="file" path="mbgl-offline.db" />
    <exclude domain="file" path="mbgl-offline.db-wal" />
    <exclude domain="file" path="mbgl-offline.db-shm" />
    <exclude domain="file" path="segments" />
    <exclude domain="file" path="brouter" />
    <exclude domain="sharedpref" path="trailscape_prefs.xml" />
</full-backup-content>
