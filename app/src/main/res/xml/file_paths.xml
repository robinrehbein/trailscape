<?xml version="1.0" encoding="utf-8"?>
<!--
    Freigaben des FileProvider (siehe AndroidManifest.xml, Authority
    "${applicationId}.fileprovider").

    Bewusst NUR ein Unterverzeichnis des Caches: Geteilt werden ausschliesslich
    frisch erzeugte Export-Dateien (GPX einer Tour, das Tour-Bild als PNG,
    spaeter Backup-JSON). Das
    eigentliche Tour-Verzeichnis (<filesDir>/rides) bleibt aussen vor — es soll
    nie ueber einen Content-Uri erreichbar sein.

    "path" ist ein Praefix relativ zu getCacheDir(); der Name muss zu dem
    Verzeichnis passen, das ui/ShareFiles.kt vorgibt (SHARE_DIR_NAME).
-->
<paths>
    <cache-path
        name="geteilte-touren"
        path="geteilte-touren/" />
</paths>
