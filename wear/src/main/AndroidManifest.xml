<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BODY_SENSORS ist die Herzfrequenz-Berechtigung bis einschliesslich
         API 35. Ab API 36 uebernimmt android.permission.health.READ_HEART_RATE
         diese Rolle; `maxSdkVersion` verhindert, dass die alte Berechtigung
         auf neuen Systemen zusaetzlich abgefragt wird. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Health Services liefert bei ExerciseType.BIKING Schritte/Kadenz und
         verweigert ohne dieses Recht Teile der Uebung. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault"
        tools:targetApi="33">

        <!-- Ehrlich: Die Uhr-App ist eine BEGLEIT-App. Sie liefert Puls und
             GPS live ans Telefon, und dort — nicht auf der Uhr — entsteht die
             gespeicherte Tour (siehe RecordingJournal-KDoc: auf der Uhr
             bleibt nur ein Ereignisprotokoll). Ohne Telefon in Reichweite ist
             der vorgesehene Weg: die Fahrt mit Samsung Health auf der Uhr
             aufzeichnen; Trailscape importiert sie danach ueber Health
             Connect (mit Historien-Freigabe auch rueckwirkend).
             `standalone="true"` heisst hier deshalb nur: Die Uhr-App laesst
             sich ohne Telefon-App installieren und starten (Wear OS 3+
             erwartet das), nicht „zeichnet ohne Telefon vollstaendig auf". -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Macht diese App fuer das Telefon per CapabilityClient auffindbar
             (FAEHIGKEIT_UHR, siehe res/values/wear.xml und WearProtocol.kt). -->
        <meta-data
            android:name="com.google.android.wearable.capability"
            android:resource="@array/android_wear_capabilities" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- foregroundServiceType="health|location": Health Services haelt die
             Uebung nur so lange am Leben, wie ein Vordergrunddienst mit diesen
             beiden Typen laeuft. Ein zusaetzlicher WakeLock waere hier ein
             Fehler und KEINE Absicherung — der Dienst allein genuegt (siehe
             RecordingService-KDoc). -->
        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="health|location"
            android:stopWithTask="false" />

        <!-- Empfaengt Steuerbefehle und den Anzeigezustand vom Telefon (siehe
             CommandListenerService-KDoc). Im Manifest deklariert statt nur
             zur Laufzeit registriert, damit das System diesen Dienst auch
             dann startet, wenn gerade keine Activity offen ist — ein Befehl
             vom Telefon darf nicht verlorengehen, nur weil niemand auf die
             Uhr schaut. `exported="true"` ist fuer einen manifestgebundenen
             WearableListenerService Pflicht, tatsaechlich erreichbar ist er
             trotzdem nur ueber die Data-Layer-APIs von Play Services, nicht
             fuer beliebige andere Apps auf dem Geraet. -->
        <service
            android:name=".comm.CommandListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/trailscape/befehl-an-uhr" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/trailscape/zustand" />
            </intent-filter>
            <!-- Was die gespeicherte Tour gebracht hat (PFAD_ABSCHLUSS). -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/trailscape/abschluss" />
            </intent-filter>
        </service>

        <!-- Serie und Wochenziel auf einen Blick (docs/wear-motivation.md, b).
             Das Telefon schreibt den Stand als DataItem; dieser Dienst nimmt ihn
             an, merkt ihn und laesst Kachel und Komplikation neu zeichnen. -->
        <service
            android:name=".glance.WochenListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/trailscape/woche" />
            </intent-filter>
        </service>

        <!-- Datums-, Zeitzonen- und Sprachwechsel: am Montag darf die Kachel
             nicht den Stand der Vorwoche behaupten. Zeitzonen- und
             Sprachwechsel sind vom Verbot impliziter Broadcasts ausgenommen;
             DATE_CHANGED ist es vermutlich nicht. Deshalb verlaesst sich der
             Wochenwechsel nicht darauf: Die Kachel laeuft kurz nach
             Mitternacht ab, die Komplikation fragt stuendlich nach. -->
        <receiver
            android:name=".glance.TagWechselReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Kachel. Die Berechtigung sorgt dafuer, dass nur das System sie bindet. -->
        <service
            android:name=".tile.WochenTileService"
            android:description="@string/wear_tile_description"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/wear_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Komplikation (Kurztext, Bereichswert, Langtext). UPDATE_PERIOD 0:
             kein Abfragetakt, aktualisiert wird auf Anforderung. -->
        <service
            android:name=".complication.WochenComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_streak"
            android:label="@string/wear_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,RANGED_VALUE,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="3600" />
        </service>
    </application>

    <queries>
        <!-- Health Services laeuft in einem eigenen Paket. Ohne diesen Eintrag
             sieht die App es unter der Paket-Sichtbarkeit ab Android 11 nicht
             und der ExerciseClient bleibt stumm. -->
        <package android:name="com.google.android.wearable.healthservices" />
    </queries>

</manifest>
